{
  "name": "dsh-mini-usage",
  "version": "1.1.0",
  "description": "DeepSeek Harness 极简中文 Token 用量统计：磨砂卡片、模型用量与热力图",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/TECHNICAL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.25.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "@playwright/test": "1.56.1",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  },
  "engines": {
    "node": ">=20.19",
    "dsh": "0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhongyichang1998/dsh-mini-usage.git"
  },
  "homepage": "https://github.com/zhongyichang1998/dsh-mini-usage#readme",
  "bugs": {
    "url": "https://github.com/zhongyichang1998/dsh-mini-usage/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "usage",
    "local-first"
  ]
}
